# ---------- Server (server/.env o ../.env) ----------
# Wallet del referee: SOLO esta cuenta puede empezar/cerrar mesas y pagar premios.
# Usá una wallet dedicada con poco saldo (solo gas), nunca la del owner.
REFEREE_PRIVATE_KEY=
FRONTEND_ORIGIN=https://tu-dominio.com

# Una red se activa cuando tiene RPC y contrato
RPC_URL_ETHEREUM=
CONTRACT_ETHEREUM=
RPC_URL_BASE=https://mainnet.base.org
CONTRACT_BASE=
RPC_URL_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
CONTRACT_ROBINHOOD=
RPC_URL_RONIN=https://api.roninchain.com/rpc
CONTRACT_RONIN=
RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_SEPOLIA=

# ---------- Frontend (Vite) ----------
# Una red sin contrato no aparece en el selector de mesas pagas
VITE_CONTRACT_ETHEREUM=
VITE_CONTRACT_BASE=
VITE_CONTRACT_ROBINHOOD=
VITE_CONTRACT_RONIN=
VITE_CONTRACT_SEPOLIA=
# Opcional: RPC propios (si no, se usa el público de cada red)
VITE_RPC_ETHEREUM=
VITE_RPC_BASE=
VITE_RPC_ROBINHOOD=
VITE_RPC_RONIN=
VITE_RPC_SEPOLIA=

# ---------- Deploy (forge script) ----------
REFEREE_ADDRESS=
FEE_RECIPIENT=
